{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM"],
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types",
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
